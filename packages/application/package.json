{
  "name": "@flowscout/application",
  "version": "0.0.1",
  "private": true,
  "description": "Use-cases / orchestration: crawl engine, agent loop, services. Depends on domain ports only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@flowscout/domain": "workspace:*"
  },
  "devDependencies": {
    "@flowscout/config": "workspace:*",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}

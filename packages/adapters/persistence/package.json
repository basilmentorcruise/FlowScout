{
  "name": "@flowscout/adapter-persistence",
  "version": "0.0.1",
  "private": true,
  "description": "Persistence adapter — implements RunRepository, StateGraphRepository, ReportRepository via PostgreSQL + Prisma.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@flowscout/domain": "workspace:*",
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@flowscout/config": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}

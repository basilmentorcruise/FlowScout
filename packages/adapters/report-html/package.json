{
  "name": "@flowscout/adapter-report-html",
  "version": "0.0.1",
  "private": true,
  "description": "HTML report renderer adapter — implements ReportRendererPort, generating browsable grouped HTML artifacts.",
  "type": "module",
  "main": "./dist/index.js",

{
  "name": "@flowscout/adapter-mobile-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Mobile MCP driver adapter — the ONLY package that imports the MCP SDK. Implements MobileDriverPort + SimulatorLifecycle.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@flowscout/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "mobile-mcp": "0.0.7"
  },
  "devDependencies": {
    "@flowscout/config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}

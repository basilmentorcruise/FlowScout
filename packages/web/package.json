{
  "name": "@flowscout/web",
  "version": "0.0.1",
  "private": true,
  "description": "FlowScout dashboard SPA — React + TypeScript + Vite, MVVM architecture. Imports domain types + api contract only.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "vite"
  },
  "dependencies": {
    "@flowscout/domain": "workspace:*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@flowscout/config": "workspace:*",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vitest": "^3.0.0"
  }
}

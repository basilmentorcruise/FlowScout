{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "composite": false,
    "incremental": false,
    "noEmit": true
  },
  "references": [{ "path": "../domain" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

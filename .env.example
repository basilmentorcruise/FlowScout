# FlowScout environment variable template.
# Copy to .env.local (gitignored) and fill in real values.
# NEVER commit real secrets — this file documents required vars with placeholders only.

# --- Vault ---
# Master key for AES-256-GCM credential encryption (adapters/vault).
# Must be a securely generated 32-byte key (e.g. `openssl rand -hex 32`).
FLOWSCOUT_VAULT_KEY=your-secret-key-here

# --- Database ---
# PostgreSQL connection string (adapters/persistence).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowscout

# --- API ---
PORT=3000
HOST=0.0.0.0

# --- LLM (provider TBD per ADR-0001 R3) ---
# LLM_API_KEY=your-llm-api-key-here
# LLM_MODEL_ID=your-model-id-here

# --- Mobile MCP adapter (adapters/mobile-mcp, E1 — ADR-0002) ---
# Command to spawn the mobile-mcp MCP server (argv array; shell:false enforced — T1/T7).
# Default uses npx which resolves the pinned package in node_modules.
# Set to an absolute path to the server binary for reproducible CI runs.
FLOWSCOUT_MCP_SERVER_COMMAND=npx,mobile-mcp

# Timeout (ms) for the initial MCP connection/handshake (default: 10000).
FLOWSCOUT_MCP_CONNECT_TIMEOUT_MS=10000

# Timeout (ms) per individual MCP tool call (default: 30000).
FLOWSCOUT_MCP_CALL_TIMEOUT_MS=30000

# Allowlisted base directory for user-supplied .app bundles (T2 — path traversal).
# installApp() will reject any appBundlePath resolving outside this directory.
# This is the single source of truth for the confinement base (E1.7 plan §2.1).
# REQUIRED for the real round-trip (Layer B E2E); optional for unit tests (Layer A).
# Example: /Users/runner/builds/apps  or  /tmp/flowscout-apps
FLOWSCOUT_APP_BUNDLE_DIR=/tmp/flowscout-apps

# --- E2E round-trip (e2e/round-trip.e2e.ts — Layer B, macOS only) ---
# Path to the fixture .app bundle for the real-simulator E2E round-trip.
# MUST reside inside FLOWSCOUT_APP_BUNDLE_DIR (T2 confinement).
# MUST be secret/PII-free — no embedded credentials, no real account data (T9).
#
# DEFAULT FIXTURE (E1.8 #29): a minimal buildable SwiftUI app is provided under
# e2e/fixtures/sample-app/. Build it (macOS + Xcode required) and capture the exports:
#   eval "$(bash e2e/fixtures/sample-app/build-fixture.sh)"
# or via package.json:
#   pnpm run e2e:build-fixture
# The script builds SampleApp.xcodeproj, copies SampleApp.app into FLOWSCOUT_APP_BUNDLE_DIR,
# and exports FLOWSCOUT_FIXTURE_APP + FLOWSCOUT_FIXTURE_BUNDLE_ID automatically.
#
# OWNER-SUPPLIED FIXTURE: set FLOWSCOUT_FIXTURE_APP to your own .app path below.
# Leave unset to let the CI build-fixture step supply the default, or to SKIP (exit 0).
# See e2e/fixtures/sample-app/README.md for full details.
FLOWSCOUT_FIXTURE_APP=

# Bundle identifier of the fixture .app (required when FLOWSCOUT_FIXTURE_APP is set).
# Must match the CFBundleIdentifier in the .app's Info.plist.
# When using the default fixture: com.flowscout.fixture.sampleapp
# (set automatically by build-fixture.sh — never hand-type this to match a built bundle).
FLOWSCOUT_FIXTURE_BUNDLE_ID=

# UDID of the iOS simulator to use for the Layer B E2E round-trip.
# If unset, the harness picks the first booted simulator from `xcrun simctl list devices booted`.
# Get UDIDs via: xcrun simctl list devices available
FLOWSCOUT_E2E_SIM_UDID=

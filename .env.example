# FlowScout environment variable template.
# Copy to .env.local (gitignored) and fill in real values.
# NEVER commit real secrets — this file documents required vars with placeholders only.

# --- Vault ---
# Master key for AES-256-GCM credential encryption (adapters/vault).
# Must be a securely generated 32-byte key (e.g. `openssl rand -hex 32`).
FLOWSCOUT_VAULT_KEY=your-secret-key-here

# --- Database ---
# PostgreSQL connection string (adapters/persistence).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowscout

# --- API ---
PORT=3000
HOST=0.0.0.0

# --- LLM (provider TBD per ADR-0001 R3) ---
# LLM_API_KEY=your-llm-api-key-here
# LLM_MODEL_ID=your-model-id-here
